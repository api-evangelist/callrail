{
  "opencollection": "1.0.0",
  "info": {
    "name": "CallRail v3 Accounts API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.callrail.com/v3/a.json",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all accounts accessible to the API key."
        },
        {
          "info": {
            "name": "Retrieve account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.callrail.com/v3/a/:account_id.json",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve account"
        }
      ]
    }
  ],
  "bundled": true
}